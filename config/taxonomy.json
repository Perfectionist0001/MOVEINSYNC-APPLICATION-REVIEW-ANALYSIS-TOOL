{
  "version": "1.0.0",
  "themes": {
    "crashes_and_updates": {
      "display_name": "Crashes & Update Issues",
      "patterns": [
        "\\bcrash(ed|es|ing)?\\b",
        "\\bfreeze(s|d|ing)?\\b",
        "\\buninstall(ed|ing|s)?\\b",
        "\\bre-?install(ed|ing|s)?\\b",
        "\\b(?:unable|cannot|can'?t|won'?t|failed)\\s+to\\s+install\\b",
        "\\b(?:after|with|since|latest|new)\\s+(?:the\\s+)?update(s)?\\b",
        "\\bupdate(s)?\\s+(?:made|broke|is\\s+worse|makes\\s+it\\s+worse|bug|issue|error|loop|problem|delay)\\b",
        "\\b(?:auto\\s+updates|dislike\\s+(?:the\\s+)?(?:new\\s+)?update|no\\s+update\\s+available)\\b",
        "\\bwhenever\\s+i\\s+update\\b",
        "\\b(?:unable|cannot|can'?t|won'?t)\\s+(?:to\\s+)?update\\b",
        "\\bslow\\s+after\\s+(?:the\\s+)?update\\b",
        "\\bupdate\\s+itself\\b",
        "\\bnot opening\\b",
        "\\bunable to open\\b",
        "\\bwon'?t open\\b",
        "\\bcan'?t open\\b",
        "\\bdoesn'?t open\\b",
        "\\bdoesn'?t start\\b",
        "\\bforce close\\b",
        "\\bstopped working\\b",
        "\\bgetting stopped\\b",
        "\\bblack screen\\b",
        "\\bwhite screen\\b",
        "\\bnot\\s+(?:installed|downloaded)\\s+(?:from|thru)\\s+(?:the\\s+)?(?:play\\s*store|playstore|app\\s*store)\\b",
        "\\bnot installed from play store\\b",
        "\\bnot downloaded from playstore\\b",
        "\\bnot downloaded from play store\\b",
        "\\bdownload(ed)? from playstore\\b",
        "\\bplaystore error\\b",
        "\\bkeep(s)? stopping\\b",
        "\\b(?<!never\\s)(?<!never\\sget\\s)(?<!never\\sgets\\s)(?<!not\\s)stuck\\b",
        "\\bcloses\\b",
        "\\bclosing\\b",
        "\\bkeeps closing\\b",
        "\\bblank screen\\b"
      ]
    },
